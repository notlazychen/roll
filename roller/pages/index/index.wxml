<view class="page">

  <!-- ============ 顶部：本月概览 ============ -->
  <view class="summary">
    <view class="summary-top">
      <view class="flex1">
        <view class="summary-label">{{monthLabel}} 支出</view>
        <view class="summary-amount num">￥{{overview.monthExpenseText}}</view>
      </view>
      <view class="summary-income" bindtap="goCharts">
        <view class="summary-label">本月收入</view>
        <view class="summary-income-num num">￥{{overview.monthIncomeText}}</view>
      </view>
    </view>

    <view class="summary-foot">
      <view class="summary-pill">
        <text class="summary-pill-label">今日支出</text>
        <text class="num">￥{{overview.todayExpenseText}}</text>
      </view>
      <view class="summary-pill">
        <text class="summary-pill-label">今日收入</text>
        <text class="num">￥{{overview.todayIncomeText}}</text>
      </view>
      <view class="summary-more" bindtap="goCharts">看图表 ›</view>
    </view>
  </view>

  <!-- ============ 搜索与筛选 ============ -->
  <view class="toolbar">
    <view class="search">
      <text class="search-icon">🔍</text>
      <input
        class="search-input"
        value="{{keyword}}"
        placeholder="搜索备注 / 渠道 / 账户"
        placeholder-class="ph"
        confirm-type="search"
        bindinput="onKeyword"
        bindconfirm="applyFilter"
      />
      <view class="search-clear" wx:if="{{keyword}}" catchtap="clearKeyword">✕</view>
    </view>
    <view class="filter-btn {{filterActive ? 'filter-btn-on' : ''}}" bindtap="toggleFilter">
      <text>筛选</text>
      <text class="filter-dot" wx:if="{{filterActive}}"></text>
    </view>
  </view>

  <!-- 筛选面板 -->
  <view class="filter-panel" wx:if="{{showFilter}}">
    <view class="filter-row">
      <view
        class="seg-item {{filter.type === '' ? 'seg-on' : ''}}"
        data-type=""
        bindtap="onFilterType"
      >全部</view>
      <view
        class="seg-item {{filter.type === 'expense' ? 'seg-on' : ''}}"
        data-type="expense"
        bindtap="onFilterType"
      >支出</view>
      <view
        class="seg-item {{filter.type === 'income' ? 'seg-on' : ''}}"
        data-type="income"
        bindtap="onFilterType"
      >收入</view>
    </view>

    <scroll-view class="filter-scroll" scroll-x enable-flex>
      <view class="chip {{filter.category === '' ? 'chip-on' : ''}}" data-cat="" bindtap="onFilterCategory">全部分类</view>
      <view
        wx:for="{{options.categories}}"
        wx:key="id"
        class="chip {{filter.category === item.name ? 'chip-on' : ''}}"
        data-cat="{{item.name}}"
        bindtap="onFilterCategory"
      >{{item.icon}} {{item.name}}</view>
    </scroll-view>

    <view class="filter-foot">
      <view class="btn btn-plain btn-sm" bindtap="resetFilter">重置</view>
      <view class="btn btn-primary btn-sm flex1" style="margin-left:16rpx;" bindtap="applyFilter">应用筛选</view>
    </view>
  </view>

  <!-- ============ 未登录提示 ============ -->
  <view class="login-tip" wx:if="{{!loggedIn && !loading}}" bindtap="goMe">
    <text class="login-tip-icon">🔑</text>
    <view class="flex1">
      <view class="login-tip-title">还没有登录</view>
      <view class="login-tip-sub">登录后才能记账，账目会按微信账号隔离</view>
    </view>
    <text class="login-tip-arrow">›</text>
  </view>

  <!-- ============ 明细列表 ============ -->
  <block wx:if="{{loggedIn}}">
    <view class="list" wx:if="{{groups.length > 0}}">
      <view class="group" wx:for="{{groups}}" wx:for-item="g" wx:key="key">
        <view class="group-head">
          <text class="group-title">{{g.label}}</text>
          <text class="group-sum num">{{g.summary}}</text>
        </view>

        <view class="group-body">
          <view
            class="entry"
            wx:for="{{g.items}}"
            wx:for-item="e"
            wx:key="id"
            data-id="{{e.id}}"
            bindtap="openEntry"
          >
            <view class="entry-icon">{{e.icon}}</view>
            <view class="flex1 entry-main">
              <view class="entry-line1">
                <text class="entry-cat">{{e.category}}</text>
                <text class="entry-channel" wx:if="{{e.channel}}">· {{e.channel}}</text>
              </view>
              <view class="entry-line2">
                <text class="entry-time">{{e.timeText}}</text>
                <text wx:if="{{e.consumer}}"> · {{e.consumer}}</text>
                <text wx:if="{{e.account}}"> · {{e.account}}</text>
                <text wx:if="{{e.remark}}" class="entry-remark"> · {{e.remark}}</text>
              </view>
              <view class="entry-tags" wx:if="{{e.tags.length > 0}}">
                <text class="tag" wx:for="{{e.tags}}" wx:for-item="t" wx:key="*this">{{t}}</text>
              </view>
            </view>
            <view class="entry-amount num {{e.isIncome ? 'income-text' : ''}}">{{e.signedText}}</view>
          </view>
        </view>
      </view>
    </view>

    <view class="empty" wx:if="{{!loading && groups.length === 0}}">
      <view class="empty-icon">📒</view>
      <view class="t-sub">{{filterActive || keyword ? '没有符合条件的账目' : '还没有账目，点右下角记第一笔'}}</view>
    </view>

    <view class="load-more" wx:if="{{groups.length > 0}}">
      <text wx:if="{{loadingMore}}">加载中…</text>
      <text wx:elif="{{hasMore}}" bindtap="loadMore">加载更多</text>
      <text wx:else class="t-tiny">{{total > 0 ? '共 ' + total + ' 笔 · ' : ''}}没有更多了</text>
    </view>
  </block>

  <view class="bottom-space" style="height: 180rpx;"></view>

  <!-- ============ 悬浮记账按钮 ============ -->
  <view class="fab" wx:if="{{loggedIn}}" bindtap="addEntry">
    <text class="fab-plus">＋</text>
  </view>
</view>
