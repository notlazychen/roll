.page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* ---------- 本月概览 ---------- */
.summary {
  margin: 24rpx 0 0;
  padding: 36rpx 32rpx 24rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #1F8A70 0%, #27A184 55%, #2BAE8A 100%);
  color: #FFFFFF;
  box-shadow: 0 12rpx 32rpx rgba(31, 138, 112, 0.25);
}

.summary-top {
  display: flex;
  align-items: flex-start;
}

.summary-label {
  font-size: 24rpx;
  opacity: 0.82;
}

.summary-amount {
  font-size: 62rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  line-height: 1.25;
  margin-top: 4rpx;
}

.summary-income {
  text-align: right;
  padding-top: 6rpx;
}

.summary-income-num {
  font-size: 30rpx;
  font-weight: 600;
  margin-top: 6rpx;
  opacity: 0.95;
}

.summary-foot {
  display: flex;
  align-items: center;
  margin-top: 26rpx;
  padding-top: 22rpx;
  border-top: 2rpx solid rgba(255, 255, 255, 0.18);
}

.summary-pill {
  display: flex;
  align-items: center;
  height: 52rpx;
  padding: 0 20rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.16);
  margin-right: 14rpx;
  font-size: 24rpx;
}

.summary-pill-label {
  opacity: 0.8;
  margin-right: 10rpx;
}

.summary-more {
  margin-left: auto;
  font-size: 24rpx;
  opacity: 0.9;
}

/* ---------- 搜索 / 筛选 ---------- */
.toolbar {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
}

.search {
  flex: 1;
  display: flex;
  align-items: center;
  height: 76rpx;
  background: #FFFFFF;
  border-radius: 38rpx;
  padding: 0 24rpx;
}

.search-icon {
  font-size: 26rpx;
  opacity: 0.55;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  min-width: 0;
}

.search-clear {
  font-size: 24rpx;
  color: #9AA096;
  padding: 0 8rpx;
}

.filter-btn {
  display: flex;
  align-items: center;
  height: 76rpx;
  padding: 0 26rpx;
  margin-left: 16rpx;
  border-radius: 38rpx;
  background: #FFFFFF;
  font-size: 26rpx;
  color: #4C544C;
  position: relative;
}

.filter-btn-on {
  background: #E6F4EF;
  color: #1F8A70;
  font-weight: 600;
}

.filter-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #E8613C;
  margin-left: 8rpx;
}

.filter-panel {
  margin-top: 16rpx;
  padding: 24rpx 24rpx 20rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
}

.filter-row {
  display: flex;
  background: #F5F6F3;
  border-radius: 20rpx;
  padding: 6rpx;
  margin-bottom: 20rpx;
}

.seg-item {
  flex: 1;
  text-align: center;
  height: 60rpx;
  line-height: 60rpx;
  font-size: 26rpx;
  color: #5C645C;
  border-radius: 16rpx;
}

.seg-on {
  background: #FFFFFF;
  color: #1F2420;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(31, 36, 32, 0.08);
}

.filter-scroll {
  white-space: nowrap;
  display: flex;
  width: 100%;
}

.filter-scroll .chip {
  flex-shrink: 0;
}

.filter-foot {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

/* ---------- 未登录 ---------- */
.login-tip {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  padding: 26rpx 24rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
}

.login-tip-icon {
  font-size: 40rpx;
  margin-right: 18rpx;
}

.login-tip-title {
  font-size: 28rpx;
  font-weight: 600;
}

.login-tip-sub {
  font-size: 24rpx;
  color: #9AA096;
  margin-top: 4rpx;
}

.login-tip-arrow {
  font-size: 36rpx;
  color: #C4C8C0;
}

/* ---------- 明细列表 ---------- */
.list {
  margin-top: 24rpx;
}

.group {
  margin-bottom: 20rpx;
}

.group-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx 10rpx;
}

.group-title {
  font-size: 24rpx;
  color: #5C645C;
  font-weight: 600;
}

.group-sum {
  font-size: 22rpx;
  color: #9AA096;
}

.group-body {
  background: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
}

.entry {
  display: flex;
  align-items: flex-start;
  padding: 24rpx 24rpx;
  position: relative;
}

.entry:active {
  background: #FAFBF9;
}

.entry::after {
  content: '';
  position: absolute;
  left: 92rpx;
  right: 24rpx;
  bottom: 0;
  height: 2rpx;
  background: #F2F3F1;
}

.entry:last-child::after {
  display: none;
}

.entry-icon {
  width: 68rpx;
  height: 68rpx;
  border-radius: 22rpx;
  background: #F5F7F4;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  flex-shrink: 0;
  margin-right: 22rpx;
}

.entry-main {
  padding-top: 2rpx;
}

.entry-line1 {
  display: flex;
  align-items: baseline;
  min-width: 0;
}

.entry-cat {
  font-size: 29rpx;
  font-weight: 600;
  color: #1F2420;
}

.entry-channel {
  font-size: 24rpx;
  color: #5C645C;
  margin-left: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.entry-line2 {
  font-size: 22rpx;
  color: #9AA096;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.entry-remark {
  color: #7C847C;
}

.entry-tags {
  margin-top: 12rpx;
  display: flex;
  flex-wrap: wrap;
}

.entry-tags .tag {
  height: 34rpx;
  font-size: 20rpx;
  margin-bottom: 0;
}

.entry-amount {
  font-size: 31rpx;
  font-weight: 600;
  color: #1F2420;
  margin-left: 16rpx;
  flex-shrink: 0;
  padding-top: 2rpx;
}

.income-text {
  color: #1F9D6B;
}

.load-more {
  text-align: center;
  padding: 24rpx 0 8rpx;
  font-size: 24rpx;
  color: #7C847C;
}

/* ---------- 悬浮按钮 ---------- */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: calc(48rpx + env(safe-area-inset-bottom));
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #1F8A70 0%, #2BAE8A 100%);
  box-shadow: 0 14rpx 32rpx rgba(31, 138, 112, 0.38);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 50;
}

.fab:active {
  transform: scale(0.94);
}

.fab-plus {
  color: #FFFFFF;
  font-size: 60rpx;
  line-height: 1;
  margin-top: -6rpx;
}
