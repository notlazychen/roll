/* 明细页 —— 对齐 Web 端 EntriesPage 的移动端布局：
   四张概览卡（2×2）→ 搜索 → 收支分段 → 整卡分组列表 → 悬浮记账 */

/* ---------- 标题行操作区（月份 + 记一笔，与 Web 移动端一致换到第二行） ---------- */
.topbar-right {
  width: 100%;
  margin-top: 16rpx;
}

.month-switch {
  display: flex;
  align-items: center;
  height: 76rpx;
  padding: 0 8rpx;
  background: var(--card);
  border: 2rpx solid var(--line);
  border-radius: 999rpx;
}

.add-btn {
  display: flex;
  align-items: center;
  height: 76rpx;
  margin-left: 20rpx;
  padding: 0 32rpx;
  border-radius: 999rpx;
  background: var(--primary-grad);
  color: #FFFFFF;
  font-size: 27rpx;
  font-weight: 600;
  box-shadow: 0 12rpx 26rpx rgba(31, 138, 112, 0.24);
}

.add-btn:active {
  opacity: 0.9;
  transform: scale(0.97);
}

.month-arrow {
  width: 56rpx;
  height: 56rpx;
  line-height: 52rpx;
  text-align: center;
  font-size: 32rpx;
  color: var(--ink-2);
  border-radius: 50%;
}

.month-arrow:active {
  background: var(--primary-soft);
  color: var(--primary);
}

.month-arrow-off {
  color: #D5D8D1;
}

.month-label {
  padding: 0 10rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink);
}

/* ---------- 搜索 ---------- */
.search {
  display: flex;
  align-items: center;
  height: 84rpx;
  margin-top: 20rpx;
  padding: 0 28rpx;
  background: var(--card);
  border: 2rpx solid var(--line);
  border-radius: 999rpx;
}

.search-icon {
  font-size: 24rpx;
  opacity: 0.5;
  margin-right: 14rpx;
}

.search-input {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: var(--ink);
}

.search-clear {
  font-size: 24rpx;
  color: var(--ink-3);
  padding: 0 6rpx 0 16rpx;
}

/* ---------- 收支筛选 ---------- */
.filter-seg {
  margin-top: 16rpx;
}

/* ---------- 列表卡 ---------- */
.list-card {
  margin-top: 20rpx;
  background: var(--card);
  border-radius: var(--r-lg);
  box-shadow: var(--shadow-card);
  padding: 4rpx 0 8rpx;
  overflow: hidden;
}

.list-empty {
  padding: 60rpx 0;
  text-align: center;
  font-size: 25rpx;
  color: var(--ink-3);
}

.group + .group {
  border-top: 2rpx solid var(--line);
}

.group-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx 12rpx;
}

.group-title {
  font-size: 25rpx;
  font-weight: 600;
  color: var(--ink-2);
}

.group-sum {
  display: flex;
  font-size: 25rpx;
  font-weight: 600;
}

.group-sum text + text {
  margin-left: 18rpx;
}

/* ---------- 单条账目 ---------- */
.entry {
  display: flex;
  align-items: center;
  padding: 22rpx 28rpx;
  position: relative;
}

.entry:active {
  background: #FAFBFC;
}

.entry::after {
  content: '';
  position: absolute;
  left: 96rpx;
  right: 28rpx;
  bottom: 0;
  height: 2rpx;
  background: #F4F5F7;
}

.entry:last-child::after {
  display: none;
}

.entry-icon {
  width: 68rpx;
  height: 68rpx;
  flex: 0 0 68rpx;
  margin-right: 22rpx;
  border-radius: 20rpx;
  background: var(--primary-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.entry-main {
  display: flex;
  flex-direction: column;
}

.entry-line1 {
  display: flex;
  align-items: center;
  min-width: 0;
}

.entry-cat {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
}

.entry-channel {
  margin-left: 14rpx;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  background: var(--fill);
  font-size: 21rpx;
  font-weight: 500;
  color: var(--ink-2);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  max-width: 240rpx;
}

.entry-line2 {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--ink-3);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.entry-remark {
  color: var(--ink-2);
}

.entry-tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 8rpx;
}

.entry-tags .tag {
  height: 34rpx;
  font-size: 20rpx;
  margin-bottom: 0;
}

.entry-amount {
  margin-left: 18rpx;
  flex-shrink: 0;
  font-size: 29rpx;
  font-weight: 700;
}

/* ---------- 加载更多 ---------- */
.load-more {
  padding: 28rpx 0 8rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--ink-3);
}

/* ---------- 悬浮按钮 ---------- */
.fab {
  position: fixed;
  right: 32rpx;
  bottom: calc(40rpx + env(safe-area-inset-bottom));
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: var(--primary-grad);
  box-shadow: var(--shadow-fab);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 50;
}

.fab:active {
  transform: scale(0.94);
}

.fab-plus {
  color: #FFFFFF;
  font-size: 56rpx;
  line-height: 1;
  margin-top: -4rpx;
}
