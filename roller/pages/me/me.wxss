/* 我的 —— 用 Web 的用户卡 + 面板语言，去掉渐变 hero */

.user-card {
  display: flex;
  align-items: center;
  padding: 26rpx 28rpx;
  margin-top: 4rpx;
}

.avatar-btn {
  width: 88rpx;
  height: 88rpx;
  padding: 0;
  margin: 0 22rpx 0 0;
  border-radius: 50%;
  background: var(--primary-grad);
  overflow: hidden;
  line-height: 1;
  flex-shrink: 0;
}

.avatar-btn::after {
  border: none;
}

.avatar-img {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
}

.avatar-ph {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.user-info {
  display: flex;
  flex-direction: column;
}

.user-name {
  font-size: 29rpx;
  font-weight: 600;
  color: var(--ink);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.user-sub {
  font-size: 22rpx;
  color: var(--ink-3);
  margin-top: 4rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.mini-btn {
  flex-shrink: 0;
  height: 56rpx;
  padding: 0 22rpx;
  line-height: 56rpx;
  border-radius: 999rpx;
  background: var(--primary-soft);
  color: var(--primary);
  font-size: 23rpx;
  font-weight: 600;
}

/* ---------- 设置行 ---------- */
.set-row {
  display: flex;
  align-items: center;
  padding: 26rpx 0;
  border-bottom: 2rpx solid var(--line);
}

.set-row:last-child {
  border-bottom: none;
}

.set-name {
  font-size: 28rpx;
  color: var(--ink);
}

.set-name.danger {
  color: var(--expense);
}

.set-sub {
  font-size: 22rpx;
  color: var(--ink-3);
  margin-top: 4rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.set-arrow {
  font-size: 32rpx;
  color: #C4C8C0;
  margin-left: 16rpx;
}

.set-switch {
  transform: scale(0.86);
  transform-origin: right center;
  margin-right: -8rpx;
}
