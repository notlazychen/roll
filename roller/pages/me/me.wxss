/* 我的 —— 用 Web 的用户卡 + 面板语言，去掉渐变 hero */

.user-card {
  display: flex;
  align-items: center;
  padding: 26rpx 28rpx;
  margin-top: 4rpx;
}

.avatar-btn {
  width: 88rpx;
  height: 88rpx;
  padding: 0;
  margin: 0 22rpx 0 0;
  border-radius: 50%;
  background: var(--primary-grad);
  overflow: hidden;
  line-height: 1;
  flex-shrink: 0;
}

.avatar-btn::after {
  border: none;
}

.avatar-img {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
}

.avatar-ph {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.user-info {
  display: flex;
  flex-direction: column;
}

.user-name {
  font-size: 29rpx;
  font-weight: 600;
  color: var(--ink);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.user-sub {
  font-size: 22rpx;
  color: var(--ink-3);
  margin-top: 4rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.mini-btn {
  flex-shrink: 0;
  height: 56rpx;
  padding: 0 22rpx;
  line-height: 56rpx;
  border-radius: 999rpx;
  background: var(--primary-soft);
  color: var(--primary);
  font-size: 23rpx;
  font-weight: 600;
}

/* ---------- 设置行 ---------- */
.set-row {
  display: flex;
  align-items: center;
  padding: 26rpx 0;
  border-bottom: 2rpx solid var(--line);
}

.set-row:last-child {
  border-bottom: none;
}

.set-name {
  font-size: 28rpx;
  color: var(--ink);
}

.set-name.danger {
  color: var(--expense);
}

.set-sub {
  font-size: 22rpx;
  color: var(--ink-3);
  margin-top: 4rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.set-arrow {
  font-size: 32rpx;
  color: #C4C8C0;
  margin-left: 16rpx;
}

.set-switch {
  transform: scale(0.86);
  transform-origin: right center;
  margin-right: -8rpx;
}

/* ---------- 顶栏扫一扫（网页扫码登录） ---------- */
.scan-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  background: var(--primary-soft);
}

.scan-icon {
  width: 30rpx;
  height: 30rpx;
  border: 4rpx solid var(--primary);
  border-radius: 6rpx;
  position: relative;
}

/* 三个定位角 + 底部扫描线，拼出一个「二维码」图形 */
.scan-icon::before {
  content: '';
  position: absolute;
  left: 4rpx;
  top: 4rpx;
  width: 7rpx;
  height: 7rpx;
  background: var(--primary);
  box-shadow: 12rpx 0 0 var(--primary), 0 12rpx 0 var(--primary);
}

.scan-icon::after {
  content: '';
  position: absolute;
  left: -6rpx;
  right: -6rpx;
  bottom: -8rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: var(--primary);
}

/* ---------- 账号面板：解绑小按钮 ---------- */
.mini-danger {
  background: var(--expense-soft);
  color: var(--expense);
}

.mini-disabled {
  opacity: 0.5;
}

/* ---------- 邮箱绑定 / 解绑弹层 ---------- */
.email-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.email-row .input {
  flex: 1;
  width: auto;
}

.send-code {
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 24rpx;
  white-space: nowrap;
}

.input-error {
  border-color: var(--expense);
  background: var(--expense-soft);
}

.field-error {
  font-size: 22rpx;
  color: var(--expense);
  margin-top: 8rpx;
}
