.page {
  min-height: 100vh;
  padding: 16rpx 24rpx 0;
}

/* ---------- 头部 ---------- */
.hero {
  margin-top: 12rpx;
  padding: 34rpx 28rpx 24rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #1F8A70 0%, #27A184 60%, #2BAE8A 100%);
  color: #FFFFFF;
  box-shadow: 0 12rpx 32rpx rgba(31, 138, 112, 0.22);
}

.hero-guest {
  text-align: center;
  padding: 56rpx 28rpx 44rpx;
}

.hero-guest .hero-avatar {
  font-size: 68rpx;
  margin-bottom: 16rpx;
}

.hero-guest .hero-name {
  font-size: 34rpx;
  font-weight: 600;
}

.hero-row {
  display: flex;
  align-items: center;
}

.avatar-btn {
  width: 112rpx;
  height: 112rpx;
  padding: 0;
  margin: 0 22rpx 0 0;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.22);
  overflow: hidden;
  line-height: 1;
}

.avatar-btn::after {
  border: none;
}

.avatar-img {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
}

.avatar-ph {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.hero-main {
  min-width: 0;
}

.hero-name {
  font-size: 34rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hero-sub {
  font-size: 22rpx;
  opacity: 0.82;
  margin-top: 6rpx;
}

.hero-edit {
  height: 52rpx;
  padding: 0 20rpx;
  line-height: 52rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.2);
  font-size: 22rpx;
  flex-shrink: 0;
}

.hero-stats {
  display: flex;
  align-items: center;
  margin-top: 30rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid rgba(255, 255, 255, 0.18);
}

.hs-item {
  flex: 1;
  text-align: center;
}

.hs-num {
  font-size: 32rpx;
  font-weight: 700;
}

.hs-label {
  font-size: 21rpx;
  opacity: 0.8;
  margin-top: 4rpx;
}

.hs-line {
  width: 2rpx;
  height: 44rpx;
  background: rgba(255, 255, 255, 0.22);
}

/* ---------- 卡片 ---------- */
.card-block {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx 24rpx 8rpx;
  margin-top: 20rpx;
}

.card-title {
  font-size: 24rpx;
  color: #9AA096;
  padding: 4rpx 0 12rpx;
}

.set-row {
  display: flex;
  align-items: center;
  min-height: 104rpx;
  border-bottom: 2rpx solid #F3F4F1;
}

.set-row:last-child {
  border-bottom: none;
}

.set-row-last {
  border-bottom: none;
}

.set-icon {
  width: 56rpx;
  font-size: 32rpx;
  flex-shrink: 0;
}

.set-name {
  font-size: 27rpx;
  color: #1F2420;
}

.set-name.danger {
  color: #E8613C;
}

.set-sub {
  font-size: 21rpx;
  color: #9AA096;
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.set-arrow {
  font-size: 32rpx;
  color: #C4C8C0;
  margin-left: 12rpx;
}

.login-err {
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: #FDECE6;
  color: #C0492A;
  font-size: 23rpx;
  line-height: 1.6;
}
