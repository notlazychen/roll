<app-frame mode="back" title="我的">
  <view class="page">

    <view class="topbar">
      <text class="topbar-title">我的</text>
      <view class="topbar-right">
        <!-- 扫一扫登录网页：扫码或在网页输入配对码批准 -->
        <view class="scan-btn" bindtap="webLogin">
          <view class="scan-icon"></view>
        </view>
      </view>
    </view>

    <!-- ============ 未登录 ============ -->
    <block wx:if="{{!loggedIn && !loading}}">
      <view class="card user-card">
        <view class="avatar">哈</view>
        <view class="flex1 user-info">
          <text class="user-name">未登录</text>
          <text class="user-sub">登录后才能记账，账目按微信账号隔离</text>
        </view>
      </view>

      <view class="panel">
        <view class="btn btn-primary" bindtap="login">微信一键登录</view>
        <view class="t-tiny mt16">登录后可记录收支、查看报表，所有数据只属于你</view>
        <view class="alert alert-error" wx:if="{{loginError}}">{{loginError}}</view>
      </view>
    </block>

    <!-- ============ 已登录 ============ -->
    <block wx:else>
      <view class="card user-card">
        <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
          <image wx:if="{{me.avatarUrl}}" class="avatar-img" src="{{me.avatarUrl}}" mode="aspectFill"></image>
          <text wx:else class="avatar-ph">{{me.initial}}</text>
        </button>
        <view class="flex1 user-info">
          <view class="user-name">{{me.name || '微信用户'}}</view>
          <view class="user-sub">已记 {{stats.entryCount}} 笔 · {{stats.sinceText}}</view>
        </view>
        <view class="mini-btn" bindtap="editName">改昵称</view>
      </view>

      <view class="stats">
        <view class="stat-card stat-accent">
          <text class="stat-label">本月支出</text>
          <text class="stat-value num expense-text">￥{{month.expenseText}}</text>
        </view>
        <view class="stat-card">
          <text class="stat-label">本月收入</text>
          <text class="stat-value num income-text">￥{{month.incomeText}}</text>
        </view>
      </view>

      <!-- ============ 记账设置 ============ -->
      <view class="panel">
        <text class="panel-title">记账设置</text>

        <view class="set-row" bindtap="goOptions" data-kind="category">
          <view class="flex1">
            <view class="set-name">分类管理</view>
            <view class="set-sub">{{counts.categories}} 个分类</view>
          </view>
          <text class="set-arrow">›</text>
        </view>

        <view class="set-row" bindtap="goOptions" data-kind="channel">
          <view class="flex1">
            <view class="set-name">渠道管理</view>
            <view class="set-sub">{{counts.channels}} 个渠道</view>
          </view>
          <text class="set-arrow">›</text>
        </view>

        <view class="set-row" bindtap="goOptions" data-kind="consumer">
          <view class="flex1">
            <view class="set-name">消费者管理</view>
            <view class="set-sub">{{counts.consumers}} 个</view>
          </view>
          <text class="set-arrow">›</text>
        </view>

        <view class="set-row" bindtap="goOptions" data-kind="account">
          <view class="flex1">
            <view class="set-name">账户管理</view>
            <view class="set-sub">{{counts.accounts}} 个账户</view>
          </view>
          <text class="set-arrow">›</text>
        </view>

        <view class="set-row" bindtap="goOptions" data-kind="tag">
          <view class="flex1">
            <view class="set-name">标签管理</view>
            <view class="set-sub">{{counts.tags}} 个标签 · 备注自动识别</view>
          </view>
          <text class="set-arrow">›</text>
        </view>
      </view>

      <!-- ============ 偏好 ============ -->
      <view class="panel">
        <text class="panel-title">偏好</text>
        <view class="set-row">
          <view class="flex1">
            <view class="set-name">备注自动打标签</view>
            <view class="set-sub">按关键词规则从备注里识别标签</view>
          </view>
          <switch class="set-switch" checked="{{me.tagAutoEnabled}}" color="#1F8A70" bindchange="onAutoTagChange" />
        </view>
      </view>

      <!-- ============ 账号 ============ -->
      <view class="panel">
        <text class="panel-title">账号</text>

        <!-- 绑定微信：未绑定点行绑定；已绑定右侧「解绑」 -->
        <view class="set-row" bindtap="{{me.wechatBound ? '' : 'bindWechat'}}">
          <view class="flex1">
            <view class="set-name">绑定微信</view>
            <view class="set-sub" wx:if="{{me.wechatBound}}">已绑定 · 解绑后可改用邮箱登录本账号</view>
            <view class="set-sub" wx:else>绑定后可用本微信一键登录；若微信属于其他账号会询问是否合并</view>
          </view>
          <view class="mini-btn mini-danger" wx:if="{{me.wechatBound}}" catchtap="unbindWechat">解绑</view>
          <text class="set-arrow" wx:else>›</text>
        </view>

        <!-- 绑定邮箱：未绑定点行绑定；已绑定显示邮箱 + 右侧「解绑」 -->
        <view class="set-row" bindtap="{{me.email ? '' : 'openEmailBind'}}">
          <view class="flex1">
            <view class="set-name">绑定邮箱</view>
            <view class="set-sub" wx:if="{{me.email}}">{{me.email}}</view>
            <view class="set-sub" wx:else>验证邮箱后即可在网页版登录同一账号</view>
          </view>
          <view class="mini-btn mini-danger" wx:if="{{me.email}}" catchtap="openEmailUnbind">解绑</view>
          <text class="set-arrow" wx:else>›</text>
        </view>

        <view class="set-row" bindtap="logout">
          <view class="flex1">
            <view class="set-name danger">退出登录</view>
          </view>
          <text class="set-arrow">›</text>
        </view>
      </view>
    </block>

    <view class="bottom-space" style="height: 80rpx;"></view>

    <!-- ============ 改昵称弹层 ============ -->
    <view class="sheet-mask" wx:if="{{showName}}" bindtap="closeName">
      <view class="sheet" catchtap="noop">
        <view class="sheet-handle"></view>
        <view class="sheet-head">
          <text class="sheet-title">修改昵称</text>
          <text class="sheet-close" bindtap="closeName">✕</text>
        </view>
        <input
          class="input"
          type="nickname"
          value="{{nameInput}}"
          maxlength="16"
          focus="{{showName}}"
          placeholder="请输入昵称"
          placeholder-class="ph"
          bindinput="onNameInput"
          bindblur="onNameInput"
        />
        <view class="btn btn-primary mt24" bindtap="saveName">保存</view>
      </view>
    </view>

    <!-- ============ 绑定 / 解绑邮箱弹层 ============ -->
    <view class="sheet-mask" wx:if="{{showEmail}}" bindtap="closeEmail">
      <view class="sheet" catchtap="noop">
        <view class="sheet-handle"></view>
        <view class="sheet-head">
          <text class="sheet-title">{{emailMode === 'bind' ? '绑定邮箱' : '解绑邮箱'}}</text>
          <text class="sheet-close" bindtap="closeEmail">✕</text>
        </view>

        <block wx:if="{{emailMode === 'bind'}}">
          <view class="t-tiny">验证通过后，就可以在网页版用这个邮箱登录同一账号，账目完全同步。</view>
          <view class="email-row mt16">
            <input
              class="input flex1 {{emailInvalid ? 'input-error' : ''}}"
              type="text"
              value="{{emailInput}}"
              placeholder="邮箱地址"
              placeholder-class="ph"
              bindinput="onEmailInput"
            />
          </view>
          <view class="field-error" wx:if="{{emailInvalid}}">请输入正确的邮箱地址</view>
        </block>
        <view class="t-tiny" wx:else>为了确认是本人操作，验证码将发送到当前绑定的邮箱 {{me.email}}。</view>

        <view class="email-row mt12">
          <input
            class="input flex1"
            type="number"
            value="{{emailCode}}"
            maxlength="6"
            placeholder="6 位邮箱验证码"
            placeholder-class="ph"
            bindinput="onEmailCodeInput"
          />
          <view
            class="mini-btn send-code {{codeCooldown > 0 || codeSending ? 'mini-disabled' : ''}}"
            bindtap="sendCode"
          >
            {{codeSending ? '发送中…' : (codeCooldown > 0 ? codeCooldown + 's 后重发' : '发送验证码')}}
          </view>
        </view>

        <view class="alert alert-error mt12" wx:if="{{emailError}}">{{emailError}}</view>

        <view class="btn btn-primary mt24 {{emailBusy ? 'btn-disabled' : ''}}" bindtap="submitEmail">
          {{emailBusy ? '处理中…' : (emailMode === 'bind' ? '确认绑定' : '确认解绑')}}
        </view>
      </view>
    </view>
  </view>
</app-frame>
