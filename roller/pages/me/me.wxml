<view class="page">

  <!-- ============ 未登录 ============ -->
  <block wx:if="{{!loggedIn && !loading}}">
    <view class="hero hero-guest">
      <view class="hero-avatar">👤</view>
      <view class="hero-name">未登录</view>
      <view class="hero-sub">登录后才能记账，账目按微信账号隔离</view>
    </view>

    <view class="card-block">
      <view class="btn btn-primary" bindtap="login">微信一键登录</view>
      <view class="t-tiny mt16" style="text-align:center;">登录后可记录收支、查看报表，所有数据只属于你</view>
      <view class="login-err" wx:if="{{loginError}}">{{loginError}}</view>
    </view>
  </block>

  <!-- ============ 已登录 ============ -->
  <block wx:else>
    <view class="hero">
      <view class="hero-row">
        <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
          <image wx:if="{{me.avatarUrl}}" class="avatar-img" src="{{me.avatarUrl}}" mode="aspectFill"></image>
          <view wx:else class="avatar-ph">{{me.initial}}</view>
        </button>
        <view class="flex1 hero-main">
          <view class="hero-name">{{me.name || '微信用户'}}</view>
          <view class="hero-sub">已记 {{stats.entryCount}} 笔 · {{stats.sinceText}}</view>
        </view>
        <view class="hero-edit" bindtap="editName">改昵称</view>
      </view>

      <view class="hero-stats">
        <view class="hs-item">
          <view class="hs-num num">￥{{month.expenseText}}</view>
          <view class="hs-label">本月支出</view>
        </view>
        <view class="hs-line"></view>
        <view class="hs-item">
          <view class="hs-num num">￥{{month.incomeText}}</view>
          <view class="hs-label">本月收入</view>
        </view>
      </view>
    </view>

    <!-- 设置 -->
    <view class="card-block">
      <view class="card-title">记账设置</view>

      <view class="set-row" bindtap="goOptions" data-kind="category">
        <text class="set-icon">🗂️</text>
        <view class="flex1">
          <view class="set-name">分类管理</view>
          <view class="set-sub">{{counts.categories}} 个分类</view>
        </view>
        <text class="set-arrow">›</text>
      </view>

      <view class="set-row" bindtap="goOptions" data-kind="channel">
        <text class="set-icon">🏪</text>
        <view class="flex1">
          <view class="set-name">渠道管理</view>
          <view class="set-sub">{{counts.channels}} 个渠道</view>
        </view>
        <text class="set-arrow">›</text>
      </view>

      <view class="set-row" bindtap="goOptions" data-kind="consumer">
        <text class="set-icon">👥</text>
        <view class="flex1">
          <view class="set-name">消费者管理</view>
          <view class="set-sub">{{counts.consumers}} 个</view>
        </view>
        <text class="set-arrow">›</text>
      </view>

      <view class="set-row" bindtap="goOptions" data-kind="account">
        <text class="set-icon">💳</text>
        <view class="flex1">
          <view class="set-name">账户管理</view>
          <view class="set-sub">{{counts.accounts}} 个账户</view>
        </view>
        <text class="set-arrow">›</text>
      </view>

      <view class="set-row" bindtap="goOptions" data-kind="tag">
        <text class="set-icon">🏷️</text>
        <view class="flex1">
          <view class="set-name">标签管理</view>
          <view class="set-sub">{{counts.tags}} 个标签 · 备注自动识别</view>
        </view>
        <text class="set-arrow">›</text>
      </view>
    </view>

    <view class="card-block">
      <view class="card-title">偏好</view>
      <view class="set-row">
        <text class="set-icon">✨</text>
        <view class="flex1">
          <view class="set-name">备注自动打标签</view>
          <view class="set-sub">按关键词规则从备注里识别标签</view>
        </view>
        <switch checked="{{me.tagAutoEnabled}}" color="#1F8A70" bindchange="onAutoTagChange" />
      </view>
    </view>

    <view class="card-block">
      <view class="set-row" bindtap="copyBaseUrl">
        <text class="set-icon">🔌</text>
        <view class="flex1">
          <view class="set-name">连接信息</view>
          <view class="set-sub">{{env.baseUrl}}</view>
        </view>
        <text class="set-arrow">›</text>
      </view>
      <view class="set-row set-row-last" bindtap="logout">
        <text class="set-icon">🚪</text>
        <view class="flex1">
          <view class="set-name danger">退出登录</view>
        </view>
        <text class="set-arrow">›</text>
      </view>
    </view>
  </block>

  <view class="bottom-space" style="height: 80rpx;"></view>

  <!-- ============ 改昵称弹层 ============ -->
  <view class="sheet-mask" wx:if="{{showName}}" bindtap="closeName">
    <view class="sheet" catchtap="noop">
      <view class="sheet-handle"></view>
      <view class="sheet-head">
        <text class="sheet-title">修改昵称</text>
        <text class="sheet-close" bindtap="closeName">✕</text>
      </view>
      <input
        class="input"
        type="nickname"
        value="{{nameInput}}"
        maxlength="16"
        focus="{{showName}}"
        placeholder="请输入昵称"
        placeholder-class="ph"
        bindinput="onNameInput"
        bindblur="onNameInput"
      />
      <view class="btn btn-primary mt24" bindtap="saveName">保存</view>
    </view>
  </view>
</view>
