/* 记一笔 —— 结构对齐 Web 端 EntryForm：
   金额（带符号）→ 收支分段 → 分类/渠道 chips → 消费者/账户/时间字段 → 备注与自动标签 */

/* ---------- 金额卡 ---------- */
.amount-card {
  padding: 34rpx 32rpx 30rpx;
  margin-top: 4rpx;
}

.amount-row {
  display: flex;
  align-items: baseline;
}

.amount-currency {
  font-size: 40rpx;
  font-weight: 600;
  white-space: nowrap;
  margin-right: 12rpx;
}

.amount-input {
  flex: 1;
  min-width: 0;
  height: 96rpx;
  padding: 0;
  font-size: 76rpx;
  font-weight: 700;
  letter-spacing: -0.02em;
  line-height: 96rpx;
  background: transparent;
}

.amount-ph {
  color: #D5D8DE;
}

.amount-hint {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: var(--expense);
}

/* ---------- 字段容器里的通道 ---------- */
.panel .field-head:first-child {
  margin-top: 0;
}

.panel .field:first-child {
  margin-top: 0;
}

/* ---------- 备注 ---------- */
.remark-input {
  width: 100%;
  min-height: 96rpx;
  padding: 22rpx 26rpx;
  background: #FAFBFC;
  border: 2rpx solid var(--line);
  border-radius: var(--r-md);
  font-size: 27rpx;
  line-height: 1.6;
  color: var(--ink);
}

/* 自动标签提示条：与 Web 的 .tagHint 一致 */
.tag-hint {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 16rpx;
  padding: 18rpx 22rpx;
  border-radius: var(--r-md);
  background: var(--primary-soft);
}

.tag-hint-label {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--primary);
  margin-right: 14rpx;
}

.tag-hint-item {
  font-size: 22rpx;
  color: var(--primary);
  background: rgba(31, 138, 112, 0.14);
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  margin-right: 10rpx;
}

/* ---------- 底部操作栏 ---------- */
.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  border-top: 2rpx solid var(--line);
  z-index: 60;
}

.action-bar .btn + .btn {
  margin-left: 16rpx;
}

.action-bar .btn-danger {
  height: 88rpx;
}
