<app-frame mode="back" title="{{frameTitle}}">
  <view class="page">

    <view class="topbar">
      <text class="topbar-title">{{isEdit ? '账目详情' : '记一笔'}}</text>
    </view>

    <!-- ============ 金额 + 收支分段 ============ -->
    <view class="card amount-card">
      <view class="amount-row">
        <text class="amount-currency {{form.type === 'income' ? 'income-text' : 'expense-text'}}">{{form.type === 'expense' ? '−' : '+'}} ￥</text>
        <input
          class="amount-input num {{form.type === 'income' ? 'income-text' : 'expense-text'}}"
          type="digit"
          value="{{form.amount}}"
          placeholder="0.00"
          placeholder-class="amount-ph"
          focus="{{autoFocus}}"
          bindinput="onAmount"
          maxlength="12"
        />
      </view>
      <view class="amount-hint" wx:if="{{amountTip}}">{{amountTip}}</view>

      <view class="seg mt20">
        <view class="seg-item {{form.type === 'expense' ? 'seg-on' : ''}}" data-type="expense" bindtap="onType">支出</view>
        <view class="seg-item {{form.type === 'income' ? 'seg-on' : ''}}" data-type="income" bindtap="onType">收入</view>
      </view>
    </view>

    <!-- ============ 分类 / 渠道 ============ -->
    <view class="panel">
      <view class="field-head">
        <text class="field-label">分类</text>
        <text class="field-action" bindtap="manageOptions" data-kind="category">管理 ›</text>
      </view>
      <view class="chips">
        <view
          wx:for="{{categories}}"
          wx:key="id"
          class="chip {{form.category === item.name ? 'chip-on' : ''}}"
          data-name="{{item.name}}"
          bindtap="onCategory"
        >{{item.icon}} {{item.name}}</view>
        <view class="chip chip-add" bindtap="newOption" data-kind="category">＋ 新增</view>
      </view>

      <view class="field-head mt24">
        <text class="field-label">渠道</text>
        <text class="field-action" bindtap="manageOptions" data-kind="channel">管理 ›</text>
      </view>
      <view class="chips">
        <view
          wx:for="{{channelItems}}"
          wx:key="id"
          class="chip {{form.channel === item.name ? 'chip-on' : ''}}"
          data-name="{{item.name}}"
          bindtap="onChannelChip"
        >{{item.shortName}}</view>
        <view class="chip chip-add" bindtap="newOption" data-kind="channel">＋ 新增</view>
      </view>
      <view class="t-tiny" wx:if="{{channelItems.length === 0}}">这个分类下还没有渠道，点「新增」加一个</view>
    </view>

    <!-- ============ 消费者 / 账户 / 交易时间 ============ -->
    <view class="panel">
      <view class="field">
        <text class="field-label">消费者</text>
        <view class="select-box" bindtap="openSheet" data-kind="consumer">
          <text class="{{form.consumer ? 'select-value' : 'select-placeholder'}}">{{form.consumer || '不限'}}</text>
          <text class="select-arrow">›</text>
        </view>
      </view>

      <view class="field">
        <text class="field-label">账户</text>
        <view class="select-box" bindtap="openSheet" data-kind="account">
          <text class="{{form.account ? 'select-value' : 'select-placeholder'}}">{{form.account || '不指定'}}</text>
          <text class="select-arrow">›</text>
        </view>
      </view>

      <view class="field">
        <text class="field-label">交易时间</text>
        <view class="select-box" bindtap="openSheet" data-kind="time">
          <text class="select-value">{{tradeText}}</text>
          <text class="select-arrow">›</text>
        </view>
      </view>
    </view>

    <!-- ============ 备注与标签 ============ -->
    <view class="panel">
      <view class="field-head">
        <text class="field-label">备注</text>
        <text class="t-tiny">{{form.remark.length}}/100</text>
      </view>

      <textarea
        class="remark-input"
        value="{{form.remark}}"
        maxlength="100"
        placeholder="写点什么，比如：和同事聚餐 AA。备注里含关键词会自动打上标签"
        placeholder-class="ph"
        bindinput="onRemark"
        auto-height
      />

      <view class="chips mt16" wx:if="{{form.tags.length > 0}}">
        <view class="chip chip-on" wx:for="{{form.tags}}" wx:key="*this" data-tag="{{item}}" bindtap="removeTag">
          {{item}} ✕
        </view>
      </view>

      <view class="tag-hint" wx:if="{{autoTags.length > 0}}">
        <text class="tag-hint-label">自动标签</text>
        <text class="tag-hint-item" wx:for="{{autoTags}}" wx:key="*this">#{{item}}</text>
      </view>

      <view class="row-between mt16">
        <text class="t-tiny">标签由备注关键词自动识别，可手动补</text>
        <text class="field-action" bindtap="openSheet" data-kind="tag">添加标签</text>
      </view>
    </view>

    <view class="bottom-space" style="height: 200rpx;"></view>

    <!-- ============ 底部操作 ============ -->
    <view class="action-bar">
      <view class="btn btn-danger btn-sm" wx:if="{{isEdit}}" bindtap="remove">删除</view>
      <view class="btn btn-primary flex1" bindtap="save">{{isEdit ? '保存修改' : '保 存'}}</view>
    </view>

    <!-- ============ 选择弹层：消费者 / 账户 ============ -->
    <view class="sheet-mask" wx:if="{{sheet === 'consumer' || sheet === 'account'}}" bindtap="closeSheet">
      <view class="sheet" catchtap="noop">
        <view class="sheet-handle"></view>
        <view class="sheet-head">
          <text class="sheet-title">{{sheetTitle}}</text>
          <text class="sheet-close" bindtap="closeSheet">✕</text>
        </view>

        <view class="sheet-body">
          <scroll-view scroll-y class="sheet-scroll">
            <view class="chips">
              <view
                wx:for="{{sheetItems}}"
                wx:key="id"
                class="chip {{form[sheet] === item.name ? 'chip-on' : ''}}"
                data-name="{{item.name}}"
                bindtap="pickOption"
              >{{item.name}}</view>
              <view class="chip chip-add" bindtap="newOption" data-kind="{{sheet}}">＋ 新增{{sheetLabel}}</view>
              <view class="chip" wx:if="{{form[sheet]}}" data-name="" bindtap="clearValue">不选</view>
            </view>
          </scroll-view>
        </view>
      </view>
    </view>

    <!-- ============ 选择弹层：标签 ============ -->
    <view class="sheet-mask" wx:if="{{sheet === 'tag'}}" bindtap="closeSheet">
      <view class="sheet" catchtap="noop">
        <view class="sheet-handle"></view>
        <view class="sheet-head">
          <text class="sheet-title">{{sheetTitle}}</text>
          <text class="sheet-close" bindtap="closeSheet">✕</text>
        </view>

        <view class="sheet-body">
          <scroll-view scroll-y class="sheet-scroll">
            <view class="chips">
              <view
                wx:for="{{options.tags}}"
                wx:key="id"
                class="chip {{form.tags.indexOf(item.name) >= 0 ? 'chip-on' : ''}}"
                data-name="{{item.name}}"
                bindtap="toggleTag"
              >{{item.name}}</view>
              <view class="chip chip-add" bindtap="newOption" data-kind="tag">＋ 新增标签</view>
            </view>
          </scroll-view>
          <view class="btn btn-primary mt16" bindtap="closeSheet">完成</view>
        </view>
      </view>
    </view>

    <!-- ============ 选择弹层：交易时间 ============ -->
    <view class="sheet-mask" wx:if="{{sheet === 'time'}}" bindtap="closeSheet">
      <view class="sheet" catchtap="noop">
        <view class="sheet-handle"></view>
        <view class="sheet-head">
          <text class="sheet-title">{{sheetTitle}}</text>
          <text class="sheet-close" bindtap="closeSheet">✕</text>
        </view>

        <view class="sheet-body">
          <scroll-view scroll-y class="sheet-scroll">
            <picker mode="date" value="{{dateValue}}" start="2020-01-01" end="2099-12-31" bindchange="onDate">
              <view class="select-box">
                <text class="select-value">日期 · {{dateValue}}</text>
                <text class="select-arrow">›</text>
              </view>
            </picker>

            <view class="chips mt16">
              <view class="chip" data-offset="0" bindtap="quickTime">现在</view>
              <view class="chip" data-offset="1" bindtap="quickTime">1 小时前</view>
              <view class="chip" data-offset="3" bindtap="quickTime">3 小时前</view>
              <view class="chip" data-offset="24" bindtap="quickTime">昨天此刻</view>
            </view>

            <picker mode="time" value="{{timeValue}}" bindchange="onTime">
              <view class="select-box mt16">
                <text class="select-value">时刻 · {{timeValue}}</text>
                <text class="select-arrow">›</text>
              </view>
            </picker>

            <view class="t-tiny mt16">交易时间是这笔钱实际发生的时间，不是记录时间</view>
          </scroll-view>
          <view class="btn btn-primary mt16" bindtap="closeSheet">完成</view>
        </view>
      </view>
    </view>

    <!-- ============ 新增选项弹层 ============ -->
    <view class="sheet-mask" wx:if="{{showNewOption}}" bindtap="closeNewOption">
      <view class="sheet" catchtap="noop">
        <view class="sheet-handle"></view>
        <view class="sheet-head">
          <text class="sheet-title">新增{{newOptionLabel}}</text>
          <text class="sheet-close" bindtap="closeNewOption">✕</text>
        </view>
        <view class="t-tiny" wx:if="{{newOptionKind === 'channel'}}">将添加到分类「{{form.category}}」下</view>
        <input
          class="input mt16"
          value="{{newOptionName}}"
          maxlength="16"
          focus="{{showNewOption}}"
          placeholder="最多 16 个字"
          placeholder-class="ph"
          bindinput="onNewOptionName"
          bindconfirm="submitNewOption"
        />
        <view class="btn btn-primary mt24" bindtap="submitNewOption">添加</view>
      </view>
    </view>
  </view>
</app-frame>
