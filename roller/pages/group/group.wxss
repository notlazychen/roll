.page {
  min-height: 100vh;
}

/* ============ 顶部栏 ============ */
.topbar {
  display: flex;
  align-items: center;
  padding: 16rpx 28rpx 8rpx;
}

.back {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  line-height: 1;
  color: #1F2233;
  padding-bottom: 8rpx;
}

.back:active {
  background: #EDEEF5;
}

.idpill {
  display: flex;
  align-items: center;
  height: 66rpx;
  padding: 0 22rpx 0 8rpx;
  border-radius: 33rpx;
  background: #FFFFFF;
  box-shadow: 0 4rpx 14rpx rgba(31, 34, 51, 0.06);
}

.idpill:active {
  opacity: 0.8;
}

.idpill-name {
  margin-left: 12rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #1F2233;
  max-width: 180rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.menu-btn {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #4A4F66;
  background: #FFFFFF;
  margin-left: 14rpx;
  box-shadow: 0 4rpx 14rpx rgba(31, 34, 51, 0.06);
}

/* ============ 小队头部 ============ */
.ghead {
  margin: 20rpx 28rpx 0;
  padding: 32rpx 30rpx 26rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #6D5BF6 0%, #9B5CFF 100%);
  box-shadow: 0 14rpx 34rpx rgba(109, 91, 246, 0.28);
}

.ghead-theme {
  display: flex;
  align-items: center;
  font-size: 48rpx;
  font-weight: 700;
  color: #FFFFFF;
  word-break: break-all;
  line-height: 1.2;
}

.pen {
  font-size: 28rpx;
  margin-left: 14rpx;
  opacity: 0.75;
}

.ghead-meta {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.meta {
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.82);
  margin-right: 20rpx;
}

.lockmeta {
  color: rgba(255, 255, 255, 0.95);
}

.members {
  margin-top: 26rpx;
  white-space: nowrap;
  width: 100%;
}

.member {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  width: 104rpx;
  margin-right: 6rpx;
  vertical-align: top;
}

.avatar-wrap {
  position: relative;
}

.avatar {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  border: 3rpx solid rgba(255, 255, 255, 0.6);
}

.avatar-sm {
  width: 52rpx;
  height: 52rpx;
  font-size: 22rpx;
  border-width: 0;
}

.leader-flag {
  position: absolute;
  right: -2rpx;
  bottom: -2rpx;
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  background: #FFC53D;
  color: #6B4300;
  font-size: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #FFFFFF;
}

.member-name {
  margin-top: 10rpx;
  font-size: 21rpx;
  color: rgba(255, 255, 255, 0.9);
  max-width: 100rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  text-align: center;
}

.add-avatar {
  background: rgba(255, 255, 255, 0.22) !important;
  border: 3rpx dashed rgba(255, 255, 255, 0.75) !important;
  font-size: 34rpx;
  color: #FFFFFF;
}

/* ============ 区块 ============ */
.section {
  margin: 28rpx 28rpx 0;
  padding: 30rpx 28rpx;
  border-radius: 28rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 26rpx rgba(31, 34, 51, 0.05);
}

/* 转盘区块：普通文档流中的卡片，层级保持在所有弹层之下 */
.wheel-section {
  position: relative;
  z-index: 1;
}

.section-dim {
  opacity: 0.5;
}

.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 22rpx;
}

/* ============ 备选项 ============ */
.opt {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 2rpx solid #F3F4F9;
}

.opt:last-child {
  border-bottom: none;
}

.opt-bar {
  width: 8rpx;
  height: 52rpx;
  border-radius: 4rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.opt-body {
  overflow: hidden;
}

.opt-title {
  font-size: 31rpx;
  font-weight: 600;
  color: #1F2233;
  word-break: break-all;
}

.opt-sub {
  font-size: 22rpx;
  color: #9AA0B5;
  margin-top: 6rpx;
}

.opt-vote-num {
  font-size: 32rpx;
  font-weight: 700;
  color: #B4B9CC;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.opt-vote-num.has {
  color: #6D5BF6;
}

.opt-vote-unit {
  font-size: 20rpx;
  font-weight: 500;
  margin-left: 2rpx;
}

.vote-btn {
  height: 60rpx;
  padding: 0 26rpx;
  border-radius: 30rpx;
  background: #F1F0FB;
  color: #6D5BF6;
  font-size: 25rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.vote-btn.voted {
  background: linear-gradient(135deg, #6D5BF6 0%, #9B5CFF 100%);
  color: #FFFFFF;
}

.vote-btn:active {
  opacity: 0.8;
}

.del-btn {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  margin-left: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #C3C8D8;
  font-size: 26rpx;
  flex-shrink: 0;
}

.del-btn:active {
  background: #FFEFF0;
  color: #FF5A5F;
}

.empty-sm {
  padding: 46rpx 20rpx;
  text-align: center;
  font-size: 27rpx;
  color: #9AA0B5;
}

/* 添加备选项 */
.add-opt {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
}

.add-btn {
  height: 88rpx;
  padding: 0 34rpx;
  margin-left: 18rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #6D5BF6 0%, #9B5CFF 100%);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.add-btn:active {
  opacity: 0.85;
}

.add-opt-hint {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #9AA0B5;
  text-align: center;
}

.ph {
  color: #B4B9CC;
}

/* 底部动作 */
.roll-area {
  margin-top: 34rpx;
}

.roll-emoji {
  margin-right: 12rpx;
  font-size: 34rpx;
}

.wait-hint {
  margin-top: 30rpx;
  padding: 26rpx;
  border-radius: 22rpx;
  background: #F6F7FB;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 27rpx;
  color: #6B7089;
}

.wait-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #6D5BF6;
  margin-right: 14rpx;
  animation: blink 1.2s infinite;
}

@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.25; }
}

/* ============ 转盘 ============ */
/* 固定高度常驻占位：标题出现/消失不能改变 canvas 的文档流位置 */
.wheel-title {
  height: 42rpx;
  line-height: 42rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #6D5BF6;
  margin-bottom: 12rpx;
}

/* 不用 flex 包裹原生 canvas：flex 容器内原生组件定位在部分环境会错位 */
.wheel-box {
  min-height: 620rpx;
  padding: 10rpx 0;
  text-align: center;
}

.wheel-canvas {
  display: inline-block;
  width: 620rpx;
  height: 620rpx;
  vertical-align: top;
}

.result-card {
  margin-top: 26rpx;
  padding: 34rpx 30rpx;
  border-radius: 26rpx;
  background: linear-gradient(160deg, #F7F5FF 0%, #FDF3FA 100%);
  text-align: center;
}

.result-label {
  font-size: 26rpx;
  color: #8A7BE8;
  font-weight: 600;
}

.result-name {
  margin-top: 14rpx;
  font-size: 60rpx;
  font-weight: 800;
  color: #1F2233;
  line-height: 1.2;
  word-break: break-all;
}

.result-meta {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #8B90A6;
}

.legend {
  margin-top: 26rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 2rpx solid #F5F6FA;
}

.legend-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 6rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.legend-title {
  flex: 1;
  font-size: 28rpx;
  color: #1F2233;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.legend-pct {
  font-size: 27rpx;
  font-weight: 600;
  color: #6B7089;
}

.legend-note {
  margin-top: 18rpx;
  font-size: 23rpx;
  color: #9AA0B5;
  text-align: center;
}

/* ============ 非成员 ============ */
.joinbar {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  bottom: calc(28rpx + env(safe-area-inset-bottom));
  height: 108rpx;
  padding: 0 22rpx 0 30rpx;
  border-radius: 54rpx;
  background: #FFFFFF;
  z-index: 50;
  display: flex;
  align-items: center;
  box-shadow: 0 12rpx 32rpx rgba(31, 34, 51, 0.14);
}

.bottom-space {
  height: 60rpx;
}

/* ============ 准备遮罩 ============ */
.prep-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(20, 22, 34, 0.5);
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 46rpx;
}

.prep-card {
  width: 100%;
  background: #FFFFFF;
  border-radius: 34rpx;
  padding: 48rpx 36rpx 34rpx;
  text-align: center;
  animation: pop 0.22s ease-out;
}

@keyframes pop {
  from { transform: scale(0.93); opacity: 0.3; }
  to { transform: scale(1); opacity: 1; }
}

.prep-emoji {
  font-size: 72rpx;
  line-height: 1;
}

.prep-title {
  margin-top: 18rpx;
  font-size: 44rpx;
  font-weight: 700;
  color: #1F2233;
}

.prep-desc {
  margin-top: 12rpx;
  font-size: 25rpx;
  color: #8B90A6;
  line-height: 1.5;
}

.prep-timer {
  margin: 30rpx 0 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.prep-timer-num {
  font-size: 72rpx;
  font-weight: 800;
  color: #6D5BF6;
  letter-spacing: 2rpx;
  font-variant-numeric: tabular-nums;
}

.prep-timer-label {
  font-size: 23rpx;
  color: #9AA0B5;
  margin-top: 4rpx;
}

.prep-wait {
  height: 88rpx;
  margin-top: 26rpx;
  border-radius: 44rpx;
  background: #F1F0FB;
  color: #6D5BF6;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.prep-wait-icon {
  margin-right: 12rpx;
}

.prep-progress {
  margin-top: 30rpx;
  padding-top: 26rpx;
  border-top: 2rpx solid #F1F2F8;
}

.prep-progress-text {
  font-size: 24rpx;
  color: #8B90A6;
}

.prep-avatars {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
}

.prep-avatars .avatar {
  margin: 6rpx;
}

/* ============ 弹层 ============ */
.dl-list {
  display: flex;
  flex-direction: column;
}

.dl-item {
  height: 96rpx;
  padding: 0 26rpx;
  border-radius: 22rpx;
  background: #F6F7FB;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 29rpx;
  color: #1F2233;
  margin-bottom: 14rpx;
}

.dl-item.active {
  background: #EFEBFF;
  color: #6D5BF6;
  font-weight: 600;
}

.dl-check {
  color: #6D5BF6;
  font-weight: 700;
}

.id-list {
  height: 420rpx;
}

.id-item {
  display: flex;
  align-items: center;
  padding: 20rpx 22rpx;
  border-radius: 22rpx;
  background: #F8F9FC;
  margin-bottom: 14rpx;
}

.id-item.active {
  background: #EFEBFF;
}

.id-name {
  font-size: 29rpx;
  font-weight: 600;
  color: #1F2233;
}

.id-check {
  color: #6D5BF6;
  font-size: 32rpx;
  font-weight: 700;
}
