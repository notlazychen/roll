<view class="page">

  <view class="head">
    <view class="flex1">
      <view class="head-title">消息</view>
      <view class="head-sub">当前身份：{{me.name}}</view>
    </view>
    <view class="clear-btn" wx:if="{{list.length > 0}}" bindtap="clearAll">清空</view>
  </view>

  <view class="list" wx:if="{{list.length > 0}}">
    <view
      class="item"
      wx:for="{{list}}"
      wx:key="id"
      data-gid="{{item.groupId}}"
      bindtap="onTapItem"
    >
      <view class="item-icon">{{item.icon}}</view>
      <view class="flex1 item-body">
        <view class="item-top">
          <text class="item-type">{{item.typeText}}</text>
          <text class="item-time">{{item.timeText}}</text>
        </view>
        <view class="item-content">{{item.content}}</view>
        <view class="item-group" wx:if="{{item.groupTheme}}">小队 · {{item.groupTheme}}</view>
      </view>
      <view class="unread-dot" wx:if="{{!item.read}}"></view>
    </view>
  </view>

  <view class="empty" wx:elif="{{!loading}}">
    <view class="empty-icon">📭</view>
    <view class="t-sub">暂时没有消息</view>
    <view class="t-muted mt8">小队动态、准备提醒与随机结果都会出现在这里</view>
  </view>

</view>
