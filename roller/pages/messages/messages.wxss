.page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.head {
  display: flex;
  align-items: flex-end;
  padding: 28rpx 32rpx 20rpx;
}

.head-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #1F2233;
}

.head-sub {
  font-size: 24rpx;
  color: #9AA0B5;
  margin-top: 6rpx;
}

.clear-btn {
  height: 60rpx;
  padding: 0 26rpx;
  border-radius: 30rpx;
  background: #FFFFFF;
  color: #6B7089;
  font-size: 25rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 14rpx rgba(31, 34, 51, 0.06);
}

.list {
  padding: 8rpx 28rpx 0;
}

.item {
  display: flex;
  align-items: flex-start;
  position: relative;
  padding: 28rpx 26rpx;
  border-radius: 26rpx;
  background: #FFFFFF;
  margin-bottom: 18rpx;
  box-shadow: 0 6rpx 20rpx rgba(31, 34, 51, 0.05);
}

.item:active {
  opacity: 0.9;
}

.item-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: #F4F2FF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  flex-shrink: 0;
}

.item-body {
  margin-left: 22rpx;
  overflow: hidden;
}

.item-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.item-type {
  font-size: 25rpx;
  font-weight: 600;
  color: #6D5BF6;
}

.item-time {
  font-size: 22rpx;
  color: #B4B9CC;
}

.item-content {
  margin-top: 8rpx;
  font-size: 29rpx;
  color: #1F2233;
  line-height: 1.45;
  word-break: break-all;
}

.item-group {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #9AA0B5;
}

.unread-dot {
  position: absolute;
  right: 22rpx;
  bottom: 26rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #FF5A5F;
}
