/* 图表页 —— 对齐 Web 端 ChartsPage 的移动端布局：
   区间分段 → 区间导航 → 三张概览卡 → 面板化图表卡 → 排行 */

.range {
  display: flex;
  align-items: center;
  padding: 22rpx 4rpx 18rpx;
}

.range-nav {
  width: 60rpx;
  height: 60rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 32rpx;
  color: var(--ink-2);
  background: var(--card);
  border: 2rpx solid var(--line);
  border-radius: 50%;
}

.range-nav:active {
  background: var(--primary-soft);
  color: var(--primary);
}

.range-nav-off {
  color: #D5D8D1;
  background: #F2F3F5;
}

.range-center {
  flex: 1;
  text-align: center;
}

.range-label {
  display: block;
  font-size: 29rpx;
  font-weight: 600;
  color: var(--ink);
}

.range-sub {
  display: block;
  font-size: 21rpx;
  color: var(--ink-3);
  margin-top: 2rpx;
}

/* ---------- 环形图 ---------- */
.donut-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.donut {
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  position: relative;
  background: #F1F3F6;
}

.donut-hole {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 188rpx;
  height: 188rpx;
  margin: -94rpx 0 0 -94rpx;
  border-radius: 50%;
  background: var(--card);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.donut-hole-label {
  font-size: 21rpx;
  color: var(--ink-3);
}

.donut-hole-num {
  margin-top: 4rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--ink);
}

.legend {
  width: 100%;
  margin-top: 28rpx;
}

.legend-row {
  display: flex;
  align-items: center;
  padding: 10rpx 0;
}

.legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 5rpx;
  flex: 0 0 16rpx;
  margin-right: 14rpx;
}

.legend-name {
  flex: 1;
  min-width: 0;
  font-size: 25rpx;
  color: var(--ink-2);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.legend-pct {
  font-size: 23rpx;
  color: var(--ink-3);
  margin-left: 14rpx;
}

.legend-amount {
  min-width: 140rpx;
  text-align: right;
  font-size: 25rpx;
  font-weight: 600;
  color: var(--ink);
}

/* ---------- 折线图 ---------- */
.legend-inline {
  display: flex;
  align-items: center;
}

.li {
  display: flex;
  align-items: center;
  font-size: 21rpx;
  color: var(--ink-2);
  margin-left: 18rpx;
}

.li-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-right: 8rpx;
}

.chart-box {
  position: relative;
  margin-top: 12rpx;
  height: 300rpx;
}

.line-canvas {
  width: 100%;
  height: 300rpx;
}

.chart-empty {
  position: absolute;
  left: 0;
  right: 0;
  top: 44%;
  text-align: center;
  font-size: 24rpx;
  color: var(--ink-3);
}

/* ---------- 排行 ---------- */
.rank-row {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
}

.rank-no {
  width: 44rpx;
  height: 44rpx;
  flex: 0 0 44rpx;
  margin-right: 14rpx;
  border-radius: 12rpx;
  background: var(--fill);
  color: var(--ink-2);
  font-size: 21rpx;
  font-weight: 600;
  text-align: center;
  line-height: 44rpx;
}

.rank-name {
  width: 132rpx;
  flex: 0 0 132rpx;
  font-size: 25rpx;
  color: var(--ink);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.rank-bar {
  flex: 1;
  height: 14rpx;
  margin: 0 16rpx;
  border-radius: 999rpx;
  background: #F1F3F6;
  overflow: hidden;
}

.rank-bar-in {
  display: block;
  height: 100%;
  border-radius: 999rpx;
  background: var(--primary-grad);
}

.rank-count {
  font-size: 21rpx;
  color: var(--ink-3);
  min-width: 74rpx;
  text-align: right;
}

.rank-amount {
  min-width: 140rpx;
  text-align: right;
  font-size: 25rpx;
  font-weight: 600;
  color: var(--ink);
}
