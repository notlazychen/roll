.page {
  min-height: 100vh;
  padding: 16rpx 24rpx 0;
}

/* ---------- 区间切换 ---------- */
.tabs {
  display: flex;
  background: #ECEDEA;
  border-radius: 22rpx;
  padding: 6rpx;
  margin-top: 8rpx;
}

.tab {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 27rpx;
  color: #5C645C;
  border-radius: 18rpx;
}

.tab-on {
  background: #FFFFFF;
  color: #1F2420;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(31, 36, 32, 0.08);
}

.range {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 8rpx 18rpx;
}

.range-nav {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  color: #1F2420;
  line-height: 1;
  padding-bottom: 4rpx;
}

.range-nav:active {
  background: #EDEFEB;
}

.range-nav-off {
  color: #D5D8D1;
  background: #F2F3F1;
}

.range-center {
  text-align: center;
}

.range-label {
  font-size: 32rpx;
  font-weight: 600;
  color: #1F2420;
}

.range-sub {
  font-size: 22rpx;
  color: #9AA096;
  margin-top: 4rpx;
}

/* ---------- 收支汇总 ---------- */
.totals {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx 8rpx;
}

.total-item {
  flex: 1;
  text-align: center;
}

.total-label {
  font-size: 22rpx;
  color: #9AA096;
}

.total-num {
  font-size: 32rpx;
  font-weight: 700;
  margin-top: 8rpx;
}

.total-line {
  width: 2rpx;
  height: 48rpx;
  background: #F0F1EE;
}

/* ---------- 卡片 ---------- */
.card-block {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 26rpx 24rpx;
  margin-top: 20rpx;
}

.block-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F2420;
}

.mini-switch {
  display: flex;
  background: #F2F3F1;
  border-radius: 18rpx;
  padding: 4rpx;
}

.mini-item {
  padding: 0 20rpx;
  height: 48rpx;
  line-height: 48rpx;
  font-size: 22rpx;
  color: #5C645C;
  border-radius: 14rpx;
}

.mini-on {
  background: #FFFFFF;
  color: #1F2420;
  font-weight: 600;
}

/* ---------- 饼图 ---------- */
.pie-wrap {
  display: flex;
  align-items: center;
  margin-top: 28rpx;
}

.pie {
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  position: relative;
  flex-shrink: 0;
  background: #F2F3F1;
}

.pie-hole {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 150rpx;
  height: 150rpx;
  margin: -75rpx 0 0 -75rpx;
  border-radius: 50%;
  background: #FFFFFF;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.pie-hole-label {
  font-size: 20rpx;
  color: #9AA096;
}

.pie-hole-num {
  font-size: 24rpx;
  font-weight: 700;
  color: #1F2420;
  margin-top: 2rpx;
}

.legend {
  flex: 1;
  margin-left: 28rpx;
  min-width: 0;
}

.legend-item {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.legend-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 4rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.legend-name {
  flex: 1;
  font-size: 23rpx;
  color: #4C544C;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.legend-pct {
  font-size: 22rpx;
  color: #9AA096;
  margin-left: 8rpx;
}

/* ---------- 分类明细 ---------- */
.cat-list {
  margin-top: 24rpx;
  padding-top: 8rpx;
  border-top: 2rpx solid #F3F4F1;
}

.cat-row {
  display: flex;
  align-items: flex-start;
  padding: 18rpx 0 6rpx;
}

.cat-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 4rpx;
  margin: 10rpx 16rpx 0 0;
  flex-shrink: 0;
}

.cat-name {
  font-size: 26rpx;
  color: #1F2420;
}

.cat-amount {
  font-size: 26rpx;
  font-weight: 600;
  color: #1F2420;
}

.bar {
  height: 10rpx;
  border-radius: 5rpx;
  background: #F2F3F1;
  margin-top: 10rpx;
  overflow: hidden;
}

.bar-in {
  height: 100%;
  border-radius: 5rpx;
}

.cat-meta {
  display: flex;
  justify-content: space-between;
  font-size: 20rpx;
  color: #9AA096;
  margin-top: 8rpx;
}

/* ---------- 折线图 ---------- */
.legend-inline {
  display: flex;
  align-items: center;
}

.li {
  display: flex;
  align-items: center;
  font-size: 21rpx;
  color: #7C847C;
  margin-left: 20rpx;
}

.li-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 8rpx;
}

.chart-box {
  position: relative;
  margin-top: 20rpx;
  height: 340rpx;
}

.line-canvas {
  width: 100%;
  height: 340rpx;
}

.chart-empty {
  position: absolute;
  left: 0;
  right: 0;
  top: 44%;
  text-align: center;
  font-size: 24rpx;
  color: #B4B9B0;
}

/* ---------- 渠道排行 ---------- */
.rank-row {
  display: flex;
  align-items: flex-start;
  margin-top: 22rpx;
}

.rank-index {
  width: 40rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #C4C8C0;
  margin-top: 2rpx;
}

.rank-name {
  font-size: 26rpx;
  color: #1F2420;
}

.rank-amount {
  font-size: 26rpx;
  font-weight: 600;
  color: #1F2420;
}
