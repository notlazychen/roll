<app-frame mode="menu" active="charts">
<view class="page">

  <!-- ============ 标题 + 区间分段 ============ -->
  <view class="topbar">
    <text class="topbar-title">图表</text>
  </view>

  <view class="seg">
    <view
      wx:for="{{tabs}}"
      wx:key="key"
      class="seg-item {{tab === item.key ? 'seg-on' : ''}}"
      data-key="{{item.key}}"
      bindtap="onTab"
    >{{item.label}}</view>
  </view>

  <!-- 区间导航 -->
  <view class="range">
    <view class="range-nav" bindtap="prevRange">‹</view>
    <view class="range-center">
      <text class="range-label">{{rangeLabel}}</text>
      <text class="range-sub">{{rangeSub}}</text>
    </view>
    <view class="range-nav {{canNext ? '' : 'range-nav-off'}}" bindtap="nextRange">›</view>
  </view>

  <!-- ============ 收支概览：三卡 ============ -->
  <view class="stats-3">
    <view class="stat-card">
      <text class="stat-label">支出</text>
      <text class="stat-value num expense-text">￥{{summary.expenseText}}</text>
      <text class="stat-em">{{summary.count}} 笔记录</text>
    </view>
    <view class="stat-card">
      <text class="stat-label">收入</text>
      <text class="stat-value num income-text">￥{{summary.incomeText}}</text>
      <text class="stat-em">日均 ￥{{summary.avgText}}</text>
    </view>
    <view class="stat-card">
      <text class="stat-label">结余</text>
      <text class="stat-value num">￥{{summary.balanceText}}</text>
      <text class="stat-em">{{summary.balanceHint}}</text>
    </view>
  </view>

  <!-- ============ 分类占比 ============ -->
  <view class="panel">
    <view class="panel-head">
      <text class="panel-title">分类占比</text>
      <view class="seg seg-sm">
        <view
          class="seg-item {{pieType === 'expense' ? 'seg-on' : ''}}"
          data-type="expense"
          bindtap="onPieType"
        >支出</view>
        <view
          class="seg-item {{pieType === 'income' ? 'seg-on' : ''}}"
          data-type="income"
          bindtap="onPieType"
        >收入</view>
      </view>
    </view>

    <view class="donut-wrap" wx:if="{{pieItems.length > 0}}">
      <view class="donut" style="{{pieStyle}}">
        <view class="donut-hole">
          <text class="donut-hole-label">{{pieType === 'expense' ? '总支出' : '总收入'}}</text>
          <text class="donut-hole-num num">￥{{pieType === 'expense' ? summary.expenseText : summary.incomeText}}</text>
        </view>
      </view>

      <view class="legend">
        <view class="legend-row" wx:for="{{pieItems}}" wx:key="name">
          <view class="legend-dot" style="background: {{item.color}};"></view>
          <text class="legend-name">{{item.name}}</text>
          <text class="legend-pct num">{{item.percentText}}</text>
          <text class="legend-amount num">￥{{item.amountText}}</text>
        </view>
      </view>
    </view>

    <view class="empty" wx:else>
      <view class="empty-icon">🍩</view>
      <view>这段时间没有{{pieType === 'expense' ? '支出' : '收入'}}记录</view>
    </view>
  </view>

  <!-- ============ 每日折线 ============ -->
  <view class="panel">
    <view class="panel-head">
      <text class="panel-title">每日收支</text>
      <view class="legend-inline">
        <view class="li"><view class="li-dot" style="background:#E05B4A;"></view><text>支出</text></view>
        <view class="li"><view class="li-dot" style="background:#1F8A70;"></view><text>收入</text></view>
      </view>
    </view>

    <view class="chart-box">
      <canvas type="2d" id="lineChart" class="line-canvas"></canvas>
      <view class="chart-empty" wx:if="{{!hasDayData}}">这段时间还没有账目</view>
    </view>
  </view>

  <!-- ============ 渠道排行 ============ -->
  <view class="panel" wx:if="{{channels.length > 0}}">
    <view class="panel-head">
      <text class="panel-title">花得最多的渠道</text>
      <text class="t-tiny">仅统计支出</text>
    </view>

    <view class="rank-row" wx:for="{{channels}}" wx:key="name">
      <text class="rank-no">{{index + 1}}</text>
      <text class="rank-name">{{item.shortName}}</text>
      <view class="rank-bar">
        <view class="rank-bar-in" style="width: {{item.ratio * 100}}%;"></view>
      </view>
      <text class="rank-count">{{item.count}} 笔</text>
      <text class="rank-amount num">￥{{item.amountText}}</text>
    </view>
  </view>

  <view class="bottom-space" style="height: 60rpx;"></view>
</view>
</app-frame>
