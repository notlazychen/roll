/* 选项源 —— 对齐 Web 端 OptionsPage 的移动端布局：
   分段 tabs → 面板（标题+说明 → 内联新增行 → chips 列表） */

.add-row {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
}

.btn-add {
  height: 88rpx;
  padding: 0 36rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
}

/* ---------- 选项 chip（带改名 / 删除） ---------- */
.opt-chip {
  display: inline-flex;
  align-items: center;
  height: 68rpx;
  padding: 0 8rpx 0 24rpx;
  margin: 0 14rpx 14rpx 0;
  border: 2rpx solid var(--line);
  border-radius: 999rpx;
  background: var(--card);
  font-size: 26rpx;
  font-weight: 500;
  color: var(--ink);
}

.opt-preset {
  margin-left: 12rpx;
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  background: var(--fill);
  font-size: 20rpx;
  color: var(--ink-3);
}

.opt-used {
  margin-left: 8rpx;
  font-size: 20rpx;
  color: var(--ink-3);
}

.opt-btn {
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  margin-left: 8rpx;
  border-radius: 50%;
  font-size: 24rpx;
  color: var(--ink-3);
}

.opt-btn:active {
  background: var(--primary-soft);
  color: var(--primary);
}

.opt-del {
  color: var(--expense);
}

.opt-del:active {
  background: var(--expense-soft);
  color: var(--expense);
}

/* ---------- 渠道分组 ---------- */
.channel-group {
  margin-top: 26rpx;
}

.channel-parent {
  font-size: 25rpx;
  font-weight: 600;
  color: var(--ink-2);
  margin-bottom: 12rpx;
  padding-left: 4rpx;
}

.opt-empty {
  padding: 24rpx 4rpx;
  font-size: 23rpx;
  color: var(--ink-3);
}

/* ---------- 标签规则 ---------- */
.rule-row {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 2rpx solid var(--line);
}

.rule-row:last-child {
  border-bottom: none;
}

.rule-kw {
  font-size: 26rpx;
  color: var(--ink);
}

.rule-tag {
  margin-top: 4rpx;
  font-size: 23rpx;
  color: var(--ink-3);
}
