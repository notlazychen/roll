<app-frame mode="menu" active="options">
  <view class="page">

    <view class="topbar">
      <text class="topbar-title">选项源</text>
    </view>

    <!-- ============ 种类切换 ============ -->
    <view class="seg">
      <view
        wx:for="{{kinds}}"
        wx:key="key"
        class="seg-item {{kind === item.key ? 'seg-on' : ''}}"
        data-key="{{item.key}}"
        bindtap="onKind"
      >{{item.label}}</view>
    </view>

    <view class="panel">
      <view class="panel-head">
        <view class="flex1">
          <text class="panel-title">{{kindLabel}}</text>
          <text class="panel-hint">{{headSub}}</text>
        </view>
      </view>

      <!-- 新增行：渠道要先选所属分类 -->
      <view class="chips" wx:if="{{kind === 'channel'}}">
        <view
          wx:for="{{options.categories}}"
          wx:key="id"
          class="chip {{addParent === item.name ? 'chip-on' : ''}}"
          data-parent="{{item.name}}"
          bindtap="pickParent"
        >{{item.name}}</view>
      </view>

      <view class="add-row">
        <input
          class="input flex1"
          value="{{addName}}"
          maxlength="16"
          placeholder="新增{{kindLabel}}"
          placeholder-class="ph"
          confirm-type="done"
          bindinput="onAddName"
          bindconfirm="submitAdd"
        />
        <view class="btn btn-add btn-primary {{addName ? '' : 'btn-disabled'}}" bindtap="submitAdd">添加</view>
      </view>

      <!-- ============ 渠道：按分类分组 ============ -->
      <block wx:if="{{kind === 'channel'}}">
        <view class="channel-group" wx:for="{{groups}}" wx:for-item="g" wx:key="parent">
          <view class="channel-parent">{{g.parent}}</view>
          <view class="chips">
            <view class="opt-chip" wx:for="{{g.items}}" wx:for-item="ch" wx:key="id">
              <text>{{ch.shortName}}</text>
              <text class="opt-preset" wx:if="{{ch.isPreset}}">预置</text>
              <text class="opt-used" wx:if="{{ch.used > 0}}">·{{ch.used}}</text>
              <text class="opt-btn" data-id="{{ch.id}}" data-name="{{ch.shortName}}" catchtap="rename">✎</text>
              <text class="opt-btn opt-del" data-id="{{ch.id}}" data-name="{{ch.name}}" data-used="{{ch.used}}" catchtap="remove">×</text>
            </view>
          </view>
          <view class="opt-empty" wx:if="{{g.items.length === 0}}">该分类下暂无渠道</view>
        </view>

        <view class="empty" wx:if="{{groups.length === 0}}">
          <view class="empty-icon">🏪</view>
          <view>还没有分类，先在「分类」里添加</view>
        </view>
      </block>

      <!-- ============ 其它：平铺 chips ============ -->
      <block wx:else>
        <view class="chips" wx:if="{{items.length > 0}}">
          <view class="opt-chip" wx:for="{{items}}" wx:key="id">
            <text>{{item.name}}</text>
            <text class="opt-preset" wx:if="{{item.isPreset}}">预置</text>
            <text class="opt-used" wx:if="{{item.used > 0}}">·{{item.used}}</text>
            <text class="opt-btn" data-id="{{item.id}}" data-name="{{item.name}}" catchtap="rename">✎</text>
            <text class="opt-btn opt-del" data-id="{{item.id}}" data-name="{{item.name}}" data-used="{{item.used}}" catchtap="remove">×</text>
          </view>
        </view>

        <view class="empty" wx:if="{{items.length === 0}}">
          <view class="empty-icon">📭</view>
          <view>还没有{{kindLabel}}，上面加一个吧</view>
        </view>
      </block>
    </view>

    <!-- ============ 标签规则（仅标签页） ============ -->
    <view class="panel" wx:if="{{kind === 'tag'}}">
      <view class="panel-head">
        <view class="flex1">
          <text class="panel-title">自动识别规则</text>
          <text class="panel-hint">备注里出现左侧关键词，就自动打上右侧标签</text>
        </view>
        <text class="field-action" bindtap="openRule">＋ 加规则</text>
      </view>

      <view class="rule-row" wx:for="{{rules}}" wx:for-item="rl" wx:key="id">
        <view class="flex1">
          <view class="rule-kw">{{rl.keywordText}}</view>
          <view class="rule-tag">→ {{rl.tag}}</view>
        </view>
        <text class="opt-btn opt-del" data-id="{{rl.id}}" catchtap="removeRule">删除</text>
      </view>

      <view class="opt-empty" wx:if="{{rules.length === 0}}">还没有规则，点「加规则」创建第一条</view>
    </view>

    <view class="bottom-space" style="height: 60rpx;"></view>

    <!-- ============ 改名弹层 ============ -->
    <view class="sheet-mask" wx:if="{{showEdit}}" bindtap="closeEdit">
      <view class="sheet" catchtap="noop">
        <view class="sheet-handle"></view>
        <view class="sheet-head">
          <text class="sheet-title">改名</text>
          <text class="sheet-close" bindtap="closeEdit">✕</text>
        </view>
        <input
          class="input"
          value="{{editName}}"
          maxlength="16"
          focus="{{showEdit}}"
          placeholder="最多 16 个字"
          placeholder-class="ph"
          bindinput="onEditName"
          bindconfirm="submitEdit"
        />
        <view class="btn btn-primary mt24" bindtap="submitEdit">保存</view>
      </view>
    </view>

    <!-- ============ 规则弹层 ============ -->
    <view class="sheet-mask" wx:if="{{showRule}}" bindtap="closeRule">
      <view class="sheet" catchtap="noop">
        <view class="sheet-handle"></view>
        <view class="sheet-head">
          <text class="sheet-title">新增识别规则</text>
          <text class="sheet-close" bindtap="closeRule">✕</text>
        </view>

        <view class="field">
          <text class="field-label">备注关键词（多个用 | 分隔）</text>
          <input
            class="input mt8"
            value="{{ruleKeyword}}"
            maxlength="120"
            focus="{{showRule}}"
            placeholder="聚餐|请客|AA"
            placeholder-class="ph"
            bindinput="onRuleKeyword"
          />
        </view>

        <view class="field">
          <text class="field-label">命中后打上标签</text>
          <view class="chips mt8">
            <view
              wx:for="{{options.tags}}"
              wx:key="id"
              class="chip {{ruleTag === item.name ? 'chip-on' : ''}}"
              data-name="{{item.name}}"
              bindtap="pickRuleTag"
            >{{item.name}}</view>
          </view>
        </view>

        <view class="btn btn-primary mt24" bindtap="submitRule">保存规则</view>
      </view>
    </view>
  </view>
</app-frame>
