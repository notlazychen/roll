/* ============ 全局设计系统 ============ */
page {
  background: #F4F5FA;
  color: #1F2233;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Helvetica, sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

view, text, input, textarea, scroll-view, button {
  box-sizing: border-box;
}

/* 主题渐变 */
.grad {
  background: linear-gradient(135deg, #6D5BF6 0%, #9B5CFF 100%);
}

.grad-soft {
  background: linear-gradient(135deg, #EFEBFF 0%, #F7F0FF 100%);
}

/* 通用卡片 */
.card {
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 28rpx rgba(31, 34, 51, 0.06);
}

.card-flat {
  background: #FFFFFF;
  border-radius: 24rpx;
  border: 2rpx solid #EEEFF6;
}

/* 文字 */
.t-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1F2233;
}

.t-sub {
  font-size: 26rpx;
  color: #6B7089;
}

.t-muted {
  font-size: 24rpx;
  color: #9AA0B5;
}

.t-tiny {
  font-size: 22rpx;
  color: #9AA0B5;
}

.primary-text {
  color: #6D5BF6;
}

/* 布局 */
.row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.row-between {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.col {
  display: flex;
  flex-direction: column;
}

.flex1 {
  flex: 1;
  min-width: 0;
}

.center {
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 按钮 */
.btn {
  height: 88rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  transition: opacity 0.15s ease, transform 0.1s ease;
}

.btn:active {
  opacity: 0.85;
  transform: scale(0.985);
}

.btn-primary {
  background: linear-gradient(135deg, #6D5BF6 0%, #9B5CFF 100%);
  color: #FFFFFF;
  box-shadow: 0 10rpx 24rpx rgba(109, 91, 246, 0.32);
}

.btn-ghost {
  background: #F1F0FB;
  color: #6D5BF6;
}

.btn-plain {
  background: #F2F3F8;
  color: #4A4F66;
}

.btn-danger {
  background: #FFEFF0;
  color: #FF5A5F;
}

.btn-disabled {
  background: #E9EAF2 !important;
  color: #A8ADBF !important;
  box-shadow: none !important;
}

.btn-sm {
  height: 64rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  padding: 0 28rpx;
}

.btn-xs {
  height: 52rpx;
  border-radius: 26rpx;
  font-size: 24rpx;
  padding: 0 22rpx;
}

/* 标签 */
.tag {
  display: inline-flex;
  align-items: center;
  height: 40rpx;
  padding: 0 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  background: #F1F0FB;
  color: #6D5BF6;
}

.tag-gray {
  background: #F2F3F8;
  color: #6B7089;
}

.tag-red {
  background: #FFEFF0;
  color: #FF5A5F;
}

.tag-green {
  background: #E9FBF0;
  color: #16A34A;
}

/* 输入 */
.input {
  height: 88rpx;
  background: #F6F7FB;
  border-radius: 22rpx;
  padding: 0 28rpx;
  font-size: 30rpx;
  color: #1F2233;
}

.input-small {
  height: 76rpx;
  font-size: 28rpx;
}

/* 遮罩与弹层 */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(20, 22, 34, 0.45);
  z-index: 300;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(20, 22, 34, 0.45);
  z-index: 300;
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  padding: 36rpx 36rpx calc(36rpx + env(safe-area-inset-bottom));
  animation: sheetUp 0.22s ease-out;
}

@keyframes sheetUp {
  from { transform: translateY(60rpx); opacity: 0.4; }
  to { transform: translateY(0); opacity: 1; }
}

.dialog {
  width: 600rpx;
  background: #FFFFFF;
  border-radius: 30rpx;
  padding: 40rpx 36rpx 30rpx;
  animation: pop 0.2s ease-out;
}

@keyframes pop {
  from { transform: scale(0.94); opacity: 0.4; }
  to { transform: scale(1); opacity: 1; }
}

/* 分割 */
.hr {
  height: 2rpx;
  background: #F0F1F7;
  width: 100%;
}

/* 空态 */
.empty {
  padding: 90rpx 40rpx;
  text-align: center;
}

.empty-icon {
  font-size: 76rpx;
  line-height: 1;
  margin-bottom: 20rpx;
  opacity: 0.55;
}

/* 头像圆 */
.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.avatar-sm {
  width: 52rpx;
  height: 52rpx;
  font-size: 22rpx;
}

/* 通用间距 */
.mt8 { margin-top: 8rpx; }
.mt12 { margin-top: 12rpx; }
.mt16 { margin-top: 16rpx; }
.mt20 { margin-top: 20rpx; }
.mt24 { margin-top: 24rpx; }
.mt32 { margin-top: 32rpx; }
.mb12 { margin-bottom: 12rpx; }
.mb16 { margin-bottom: 16rpx; }
.mb24 { margin-bottom: 24rpx; }
