<!-- 顶部条：与 Web 移动端 .mobile-bar 一致 -->
<view
  class="mobile-bar"
  style="padding-top: {{statusBarHeight}}px; height: {{statusBarHeight + navHeight}}px;"
>
  <view class="bar-left">
    <view wx:if="{{mode === 'menu'}}" class="burger" bindtap="openDrawer">
      <view class="burger-line"></view>
      <view class="burger-line"></view>
      <view class="burger-line"></view>
    </view>
    <view wx:else class="back" bindtap="goBack">‹</view>
    <text class="bar-title">{{mode === 'menu' ? currentName : title}}</text>
  </view>
  <text class="bar-brand" style="margin-right: {{brandRight}}px;">哈姆斯特</text>
</view>

<!-- 抽屉遮罩 -->
<view class="drawer-mask" wx:if="{{drawerOpen}}" bindtap="closeDrawer"></view>

<!-- 抽屉：工具名 + 切换按钮 + 当前工具的子导航 + 用户卡（对齐 Web 侧边栏） -->
<view class="drawer {{drawerOpen ? 'drawer-open' : ''}}" catchtap="noop">
  <view class="drawer-scroll" style="padding-top: {{statusBarHeight + 12}}px;">

    <!-- 头部：当前工具（图标 + 名称）+ 切换按钮 -->
    <view class="drawer-head">
      <view class="tool-badge">{{currentIcon}}</view>
      <text class="tool-name">{{currentName}}</text>
      <view
        class="tool-toggle {{toolMenuOpen ? 'tool-toggle-on' : ''}}"
        bindtap="toggleToolMenu"
        aria-role="button"
        aria-label="切换工具"
      >
        <text class="tool-toggle-icon">⇄</text>
      </view>
    </view>

    <!-- 工具列表：点切换按钮展开 -->
    <view class="tool-menu" wx:if="{{toolMenuOpen}}">
      <view class="tool-menu-label">切换工具</view>
      <view
        wx:for="{{tools}}"
        wx:key="key"
        wx:for-item="t"
        class="tool-item {{t.key === currentTool ? 'tool-item-on' : ''}} {{t.ready ? '' : 'tool-item-off'}}"
        data-key="{{t.key}}"
        bindtap="pickTool"
      >
        <view class="tool-item-icon">{{t.icon}}</view>
        <view class="tool-item-text">
          <view class="tool-item-name">
            <text>{{t.name}}</text>
            <text wx:if="{{t.key === currentTool}}" class="tag-now">当前</text>
            <text wx:elif="{{!t.ready}}" class="tag-soon">即将上线</text>
          </view>
          <text class="tool-item-desc">{{t.desc}}</text>
        </view>
        <text wx:if="{{t.key === currentTool}}" class="tool-item-check">✓</text>
      </view>
    </view>

    <!-- 当前工具的子导航 -->
    <view class="nav-label">当前工具</view>
    <view class="nav-group">
      <view
        wx:for="{{currentNavs}}"
        wx:key="key"
        class="nav-item {{active === item.key ? 'nav-on' : ''}}"
        data-key="{{item.key}}"
        data-url="{{item.url}}"
        bindtap="goNav"
      >
        <text class="nav-icon">{{item.icon}}</text>
        <text class="nav-text">{{item.label}}</text>
      </view>
      <text wx:if="{{!currentNavs.length}}" class="nav-empty">这个工具还在打造中，敬请期待。</text>
    </view>

    <view class="drawer-spacer"></view>

    <view class="drawer-foot">哈姆斯特 · 仓鼠之家</view>

    <view class="user-card" bindtap="goMe">
      <view class="avatar">
        <image wx:if="{{user.avatarUrl}}" class="avatar-img" src="{{user.avatarUrl}}" mode="aspectFill" />
        <text wx:else>{{user.initial}}</text>
      </view>
      <view class="user-info">
        <text class="user-name">{{user.name || '未登录'}}</text>
        <text class="user-sub">{{user.sub}}</text>
      </view>
      <text class="user-arrow">›</text>
    </view>

  </view>
</view>

<!-- 页面内容 -->
<slot />
