{
  "//": "复制成 appsettings.Development.json 后按需修改。该文件不会提交到仓库。",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Microsoft.EntityFrameworkCore.Query": "Warning"
    }
  },
  "ConnectionStrings": {
    "//": "本地开发连接串。Timeout 不要设成 0（无限等待），否则数据库不可达时启动会一直挂着。",
    "Roll": "Host=127.0.0.1;Port=5432;Username=postgres;Password=你的密码;Database=roll;Timeout=15;Command Timeout=120;MinPoolSize=0;MaxPoolSize=50;"
  },
  "Database": {
    "AutoMigrate": true
  },
  "Jwt": {
    "//": "本地随便用一个足够长的串即可；生产必须换成随机值",
    "Key": "dev-only-random-group-jwt-key-please-change-in-production-32chars"
  },
  "Auth": {
    "//": "开发模式登录：不接微信也能造账号，方便本机验证多人流程。生产必须 false。",
    "AllowDevLogin": true
  }
}
