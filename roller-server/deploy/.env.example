# 复制成 .env 后按需修改。这个文件不要提交到仓库。

# ---- 镜像 ----
# 由 GitHub Actions 构建推送到 Docker Hub，服务器 pull 这个镜像。
# 默认 latest；要锁定版本就改成 crazor6/roll:sha-a1b2c3d 这样的具体标签。
ROLL_IMAGE=crazor6/roll:latest

# ---- 数据库 ----
# 线上默认在 compose 内起一个 postgres（POSTGRES_* 三行）。
# 如果改用已有的 PostgreSQL，把下面这行 ConnectionStrings__Roll 解开注释并填好。
POSTGRES_USER=postgres
POSTGRES_PASSWORD=换成一个强密码
POSTGRES_DB=ledger

# ConnectionStrings__Roll=Host=你的数据库地址;Port=5432;Username=postgres;Password=你的密码;Database=ledger;Timeout=15;Command Timeout=120

# ---- 鉴权 ----
# 生成方式：openssl rand -base64 48
Jwt__Key=请替换成至少32位的随机字符串请替换成至少32位的随机字符串
Jwt__Issuer=ledger
Jwt__Audience=ledger-miniprogram

# ---- 微信小程序 ----
# AppId 与小程序前端 project.config.json 里的一致；AppSecret 只能放在这里（服务端）
WeChat__AppId=
WeChat__AppSecret=

# ---- 其它 ----
# 线上首次发布时设为 true 跑一次建表，之后建议改回 false 并在发布流程里单独执行迁移
Database__AutoMigrate=true
