# 复制成 .env 后按需修改。这个文件不要提交到仓库。

# ---- 镜像 ----
# 由 GitHub Actions 构建推送到 Docker Hub，服务器 pull 这个镜像。
# 默认 latest；要锁定版本就改成 crazor6/roll:sha-a1b2c3d 这样的具体标签。
ROLL_IMAGE=crazor6/roll:latest

# ---- 数据库 ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=换成一个强密码
POSTGRES_DB=roll

# 如果你要连已有的 PostgreSQL（而不是 compose 里的 db 服务），直接覆盖成完整连接串：
# ConnectionStrings__Roll=Host=192.168.123.154;Port=5432;Username=postgres;Password=你的密码;Database=roll;Timeout=15;Command Timeout=120

# ---- 鉴权 ----
# 生成方式：openssl rand -base64 48
Jwt__Key=请替换成至少32位的随机字符串请替换成至少32位的随机字符串
Jwt__Issuer=random-group
Jwt__Audience=random-group-miniprogram

# ---- 微信小程序 ----
# AppId 与小程序前端 project.config.json 里的一致；AppSecret 只能放在这里（服务端）
WeChat__AppId=
WeChat__AppSecret=

# ---- 其它 ----
Database__AutoMigrate=true
